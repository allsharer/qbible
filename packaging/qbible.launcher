#!/usr/bin/python3
# qbible launcher. Finds its private Python package relative to its own
# location (<prefix>/bin/qbible -> <prefix>/share/qbible/python), so the same
# file works for the Debian package (/usr) and per-user installs (~/.local).
import os
import sys

_share = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "share", "qbible")
sys.path.insert(0, os.path.normpath(os.path.join(_share, "python")))

from qbible.cli import main  # noqa: E402

sys.exit(main())
