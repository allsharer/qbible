<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never upload user data to cloud backup; allow device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.sqlite" />
        <include domain="sharedpref" path="qbible_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
